# Copiez ce fichier en .env.local et renseignez vos valeurs (Supabase > Project Settings > API).
# Ne commitez JAMAIS .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# URL publique de l'application (utilisée pour le lien de réinitialisation du mot de passe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Uniquement pour les scripts de sauvegarde locale (jamais exposée au navigateur, jamais sur Vercel)
# Supabase > Project Settings > Database > Connection string (URI, mode "Session")
SUPABASE_DB_URL=postgresql://postgres.xxxx:mot-de-passe@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
